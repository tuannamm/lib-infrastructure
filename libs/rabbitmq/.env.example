# AMQP path is the virtual host; exchange is configured separately.
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=w-notification
RABBITMQ_EXCHANGE=pm.events
RABBITMQ_DLX=pm.events.dlx
RABBITMQ_DLQ=w-notification.dlq
# Total processing attempts; 0 (default) and 1 both mean no retries.
RABBITMQ_RETRY_COUNT=0
